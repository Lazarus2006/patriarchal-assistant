  "apps": {
    "_comment": "launch.all.desktop = .desktop IDs tried with gtk-launch in order; launch.all.bins = binaries tried after (absolute paths allowed). kill = anchored regexes for `pkill -f` against the full command line. Unless an entry says ASSUMPTION, its ids/binaries are confirmed by the diagnostics (.desktop Exec lines confirm binaries for apps `command -v` didn't find: cosmic-store, cosmic-player, cosmic-viewer, popsicle-gtk, obs).",

    "brave": {
      "name": "Brave",
      "aliases": ["brave browser", "browser", "the browser", "brave web browser"],
      "browser": true,
      "_comment": "browser:true => executor uses brave_ensure_running() (CDP flags + dedicated profile). Kill targets ONLY the CDP-profile instance (never a normal Brave): user-data-dir is expanded from ~ before launch, so the cmdline contains the literal path ending in brave-cdp-profile.",
      "launch": { "all": { "desktop": [], "bins": ["brave-browser"] } },
      "kill": ["user-data-dir=[^ ]*brave-cdp-profile"]
    },
    "vscode": {
      "name": "VS Code",
      "aliases": ["vs code", "visual studio code", "vscode", "v s code", "code editor"],
      "_comment": "Desktop id com.microsoft.VSCode exists but we launch the `code` binary directly. `code` opens a new window each time (executor-side limitation).",
      "launch": { "all": { "desktop": [], "bins": ["code"] } },
      "kill": ["(^|/)code( |$)"]
    },
