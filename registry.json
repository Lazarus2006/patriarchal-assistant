{
  "_comment": "Pop!_OS 24.04 ONLY. COSMIC/Wayland and the Xorg (GNOME-on-x11) session share identical app launch data, so every app uses launch.all. Loaded once by executor.load_registry(); keys starting with '_' are comments. Adding a site/app = edit this file + the static key list in system_prompt.txt + fine-tune data. Desktop ids and binaries were checked against registry-diagnostic-cosmic.txt / -xorg.txt; anything NOT confirmed there carries an 'ASSUMPTION:' note.",

  "defaults": {
    "media_service": "youtube_music"
  },

  "browser": {
    "_comment": "Brave MUST run on a dedicated profile for CDP (Chromium blocks remote debugging on the default user-data-dir). Log into WhatsApp/YouTube/etc. once in this profile. window_class_hint is best-effort X11 only (wmctrl, verified installed); no effect on COSMIC/Wayland.",
    "binaries": ["brave-browser"],
    "cdp_port": 9222,
    "user_data_dir": "~/.config/brave-cdp-profile",
    "extra_flags": ["--no-first-run", "--no-default-browser-check"],
    "window_class_hint": "brave-browser"
  },

  "web_search": {
    "_comment": "Brave Search because we're already on Brave. Swap for SearXNG later: http://192.168.x.x:8080/search?q={q}",
    "url": "https://search.brave.com/search?q={q}"
  },

  "window": {
    "_comment": "Backs the `window` verb: act on the CURRENTLY FOCUSED window. ops.<op> = { aliases[], done, x11[[cmd...]], wayland[[cmd...]] }. For the active session type the executor runs the first command whose binary exists and exits 0. Empty list = unsupported there (executor says so). VERIFIED: wmctrl is installed. NOT verified (not in diagnostics): xdotool, wtype, ydotool - install what you use. wmctrl only sees X11/XWayland windows, so it is used for the x11 session only; on COSMIC/Wayland a focused native window is invisible to it. ASSUMPTION: the wayland key combos below (Alt+F4 close, Super+M maximize-toggle) rely on a synthetic-keyboard tool being accepted by cosmic-comp. Test: sleep 3; wtype -M alt -k F4 -m alt  (with a throwaway window focused).",
    "ops": {
      "close": {
        "aliases": ["close window", "close the window", "close this", "close it", "close current", "close current window", "close focused window", "quit window", "shut window", "exit window"],
        "done": "Closed the window.",
        "x11": [["wmctrl", "-c", ":ACTIVE:"]],
        "wayland": [
          ["wtype", "-M", "alt", "-k", "F4", "-m", "alt"],
          ["ydotool", "key", "56:1", "62:1", "62:0", "56:0"]
        ]
      },
      "minimize": {
        "aliases": ["minimise", "minimize window", "minimise window", "minimize this", "minimise this", "hide window", "hide this", "shrink window"],
        "done": "Minimized the window.",
        "x11": [["xdotool", "getactivewindow", "windowminimize"]],
        "wayland": []
      },
      "maximize": {
        "aliases": ["maximise", "maximize window", "maximise window", "maximize this", "maximise this", "expand window", "full size", "make it bigger"],
        "done": "Maximized the window.",
        "x11": [["wmctrl", "-r", ":ACTIVE:", "-b", "add,maximized_vert,maximized_horz"]],
        "wayland": [["wtype", "-M", "logo", "-k", "m", "-m", "logo"]]
      }
    }
  },

  "brightness": {
    "_comment": "Backs set_brightness. {val} is replaced by '40%' (level) or '+20%'/'−20%' (delta). Session-specific list first, 'all' fallback. First command whose binary exists and exits 0 wins. Install: sudo apt install brightnessctl",
    "wayland": [["brightnessctl", "set", "{val}"]],
    "x11":     [["brightnessctl", "set", "{val}"]],
    "all":     [["brightnessctl", "set", "{val}"]]
  },
  
  "toggles": {
    "_comment": "Backs the `toggle` verb. Each feature has 'on'/'off' → {wayland:[[cmd...]], x11:[[cmd...]], all:[[cmd...]]}. First command whose binary exists and exits 0 wins. Empty list = unsupported. NOTE night_light/dnd use gsettings — they work on GNOME (Xorg session); on pure COSMIC they may need a different backend. Test with diagnose-features.sh before trusting them.",
    "bluetooth": {
      "name": "Bluetooth",
      "aliases": ["bluetooth", "bt", "blue tooth"],
      "on":  { "all": [["bluetoothctl", "power", "on"]] },
      "off": { "all": [["bluetoothctl", "power", "off"]] }
    },
    "wifi": {
      "name": "Wi-Fi",
      "aliases": ["wifi", "wi fi", "wi-fi", "wireless", "net"],
      "on":  { "all": [["nmcli", "radio", "wifi", "on"]] },
      "off": { "all": [["nmcli", "radio", "wifi", "off"]] }
    },
    "night_light": {
      "name": "Night Light",
      "aliases": ["night light", "nightlight", "night mode", "blue light filter", "warm light"],
      "on":  { "all": [["gsettings", "set", "org.gnome.settings-daemon.plugins.color", "night-light-enabled", "true"]] },
      "off": { "all": [["gsettings", "set", "org.gnome.settings-daemon.plugins.color", "night-light-enabled", "false"]] }
    },
    "dnd": {
      "name": "Do Not Disturb",
      "aliases": ["do not disturb", "dnd", "silence notifications", "mute notifications", "silent mode"],
      "on":  { "all": [["gsettings", "set", "org.gnome.desktop.notifications", "show-banners", "false"]] },
      "off": { "all": [["gsettings", "set", "org.gnome.desktop.notifications", "show-banners", "true"]] }
    },
    "mute": {
      "name": "Mute",
      "aliases": ["mute", "audio mute", "speaker mute", "sound mute"],
      "on":  { "all": [["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1"]] },
      "off": { "all": [["pactl", "set-sink-mute", "@DEFAULT_SINK@", "0"]] }
    }
  },

