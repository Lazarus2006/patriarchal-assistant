  "media": {
    "_comment": "search_prefix = yt-dlp search prefix (1 = top hit). watch_url = template filled with the video ID. mode 'ui' opens the result in Brave. recipe = Playwright fallback. site = sites key for the last-resort 'open the search page' fallback.",
    "youtube": {
      "name": "YouTube",
      "aliases": ["you tube", "yt", "youtube video", "videos"],
      "search_prefix": "ytsearch1:",
      "watch_url": "https://www.youtube.com/watch?v={id}",
      "mode": "ui",
      "mpv_args": [],
      "recipe": "youtube_play",
      "site": "youtube"
    },
    "youtube_music": {
      "name": "YouTube Music",
      "aliases": ["yt music", "ytmusic", "youtube music", "music", "songs"],
      "search_prefix": "ytsearch1:",
      "watch_url": "https://music.youtube.com/watch?v={id}",
      "mode": "ui",
      "mpv_args": ["--no-video"],
      "recipe": "youtube_music_play",
      "site": "youtube_music"
    }
  },

  "recipes": {
    "_comment": "FALLBACKS ONLY: play_media resolves via yt-dlp and opens the direct watch URL, bypassing these. They run only if yt-dlp fails. CSS selectors target the current YouTube / YT Music DOM and WILL rot; fix them here, not in Python. Steps: goto ({q} URL-encoded) | wait_for (selector) | click (first match) | wait (ms); optional per-step: timeout_ms, optional:true.",
    "youtube_music_play": {
      "requires": ["q"],
      "reuse_prefix": "https://music.youtube.com",
      "steps": [
        { "goto": "https://music.youtube.com/search?q={q}" },
        { "wait_for": "ytmusic-responsive-list-item-renderer", "timeout_ms": 12000 },
        { "click": "ytmusic-responsive-list-item-renderer a.yt-simple-endpoint", "timeout_ms": 8000 },
        { "wait": 1500 }
      ]
    },
    "youtube_play": {
      "requires": ["q"],
      "reuse_prefix": "https://www.youtube.com",
      "steps": [
        { "goto": "https://www.youtube.com/results?search_query={q}" },
        { "wait_for": "ytd-video-renderer a#video-title", "timeout_ms": 12000 },
        { "click": "ytd-video-renderer a#video-title", "timeout_ms": 8000 },
        { "wait": 1500 }
      ]
    }
  }
}
